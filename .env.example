# აპლიკაციის runtime კავშირი (Prisma adapter). ცარიელი მნიშვნელობა — საიდუმლო აქ არ ჩაწეროთ.
DATABASE_URL=

# Prisma CLI-ის პირდაპირი კავშირი მიგრაციისთვის.
DIRECT_URL=

# ლოკალური ბაზის ადმინისტრატორის კავშირი bootstrap სკრიპტებისთვის.
DB_ADMIN_URL=

# ცალკე auth როლის კავშირი.
AUTH_DB_URL=

# აპლიკაციის საჯარო მისამართი.
# Production-ში სავალდებულოა HTTPS მისამართი (https://).
# ლოკალურად დაშვებულია http://127.0.0.1:3000.
APP_ORIGIN=

# Supabase პროექტის მისამართი.
SUPABASE_URL=

# Supabase-ის publishable გასაღები. Service-role საიდუმლო აქ არ ჩაწეროთ.
SUPABASE_PUBLISHABLE_KEY=

# "true" მხოლოდ standalone auth-ისთვის. სხვა შემთხვევაში დატოვეთ ცარიელი.
SUPABASE_STANDALONE_AUTH=
